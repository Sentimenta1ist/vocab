# ── Required ───────────────────────────────────────────────────────────────

# Gemini API key (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Postgres password (choose a strong random value)
POSTGRES_PASSWORD=change_me

# JWT signing secret — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_string

# Full async database URL — update the password to match POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://vocab:change_me@postgres:5432/vocab

# ── Optional ───────────────────────────────────────────────────────────────

# Postgres DB / user (default: vocab)
POSTGRES_DB=vocab
POSTGRES_USER=vocab

# Your local timezone (used to set next_review_at to midnight of the target day)
TIMEZONE=Europe/Dublin

# How many new cards can enter a study session per day
NEW_CARDS_DAILY_CAP=20

# Port to bind (Coolify sets this automatically)
PORT=8000
